<?xml version="1.0" encoding="UTF-8"?>
<!--
  The React/NestJS platform's server-to-server principal (solution design S6.4).

  Deliberately carries no consumerKey: Salesforce generates one per org on deploy, and committing
  a key ties the repo to a single org. The consumer secret is never available through the Metadata
  API at all, which is why the client credentials "Run As" user and the secret are the two steps
  the README hands to a human.
-->
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>bruno.romano182@gmail.com</contactEmail>
    <description>The React/NestJS platform's server-to-server principal. Client credentials flow, running as svc.revtech.cpq. See solution design S6.4.</description>
    <label>RevTech CPQ Platform</label>
    <oauthConfig>
        <callbackUrl>http://localhost:1717/OauthRedirect</callbackUrl>
        <isClientCredentialEnabled>true</isClientCredentialEnabled>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <isPkceRequired>true</isPkceRequired>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
    </oauthConfig>
    <oauthPolicy>
        <ipRelaxation>ENFORCE</ipRelaxation>
        <refreshTokenPolicy>infinite</refreshTokenPolicy>
    </oauthPolicy>
</ConnectedApp>
