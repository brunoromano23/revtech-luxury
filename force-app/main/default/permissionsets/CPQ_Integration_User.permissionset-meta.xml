    <!--
      Standard fields the services read. Custom-field FLS alone is not enough: this permission set
      granted only the fields this project created, so a least-privilege principal could read an
      Opportunity's Id and nothing else, and SOQL reported "No such column 'AccountId'" rather than
      a permission error. Fields that are not FLS-controlled at all (StageName, IsClosed, Quantity,
      UnitPrice, OpportunityId, PricebookEntryId) are deliberately absent — they follow object
      access and cannot be listed here.
    -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Opportunity.AccountId</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>OpportunityLineItem.TotalPrice</field>
