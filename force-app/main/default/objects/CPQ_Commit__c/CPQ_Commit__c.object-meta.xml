<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One row per commit attempt. The unique Idempotency_Key__c is what makes R-17 enforceable by the database rather than by a check-then-insert race (design doc S4.3).</description>
    <enableActivities>false</enableActivities>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>CPQ Commit</label>
    <nameField>
        <label>Commit</label>
        <displayFormat>CMT-{000000}</displayFormat>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>CPQ Commits</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
